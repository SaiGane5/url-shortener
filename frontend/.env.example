###############################################################################
# Frontend configuration.
#
#   cp .env.example .env
#
# IMPORTANT: Vite inlines every VITE_* variable into the JavaScript bundle at
# BUILD time. Anything here is public and visible in devtools, so this file
# must never contain a secret, a token, or an API key. The backend is the only
# place credentials exist.
###############################################################################

# Base URL of the API.
#
# Leave EMPTY for same-origin requests (the default, and what the Docker build
# uses): the browser calls whatever host served the page, so Nginx routes
# /api/... to the backend and no environment-specific URL is ever compiled in.
#
# Set it only when the frontend is served from a different origin than the API,
# e.g. pointing a local `npm run dev` at a remote backend:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Origin used to render short links. Also normally empty (same origin as the
# page). Set it if short links live on a dedicated short domain.
VITE_SHORT_LINK_BASE_URL=

# Link target for the "API docs" nav item.
VITE_API_DOCS_URL=/docs
