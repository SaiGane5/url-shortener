###############################################################################
# Backend / infrastructure configuration.
#
#   cp .env.example .env
#
# Every value below is a development default and is SAFE TO COMMIT. Real
# credentials must never be written here -- see docs/PRODUCTION_READINESS.md
# ("Secrets management") for how these are expected to be supplied in a real
# deployment (injected by the platform's secret store, never baked into an
# image or a compose file).
###############################################################################

# ----------------------------------------------------------------- app ------
APP_NAME=url-shortener
# local | test | staging | production
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
# json for machine-parseable logs, console for readable local output.
LOG_FORMAT=json

# Origin used to build the `short_url` field in API responses. Behind the load
# balancer this is the load balancer's public origin, NOT the container's.
PUBLIC_BASE_URL=http://localhost:8080

# Interactive API docs at /docs and /redoc. Consider disabling in production if
# the API is not meant to be publicly explorable.
DOCS_ENABLED=true
METRICS_ENABLED=true

# ------------------------------------------------------------ database ------
# Async driver (asyncpg) -- required, the app has no sync path.
DATABASE_URL=postgresql+asyncpg://urlshort:urlshort@postgres:5432/urlshort
# Keep DB_POOL_SIZE * number_of_api_replicas well under PostgreSQL's
# max_connections (default 100). 10 x 2 replicas = 20 steady + overflow.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5.0
DB_POOL_RECYCLE_SECONDS=1800
DB_COMMAND_TIMEOUT_SECONDS=5.0
DB_ECHO=false

# Credentials consumed by the postgres container itself.
POSTGRES_USER=urlshort
POSTGRES_PASSWORD=urlshort
POSTGRES_DB=urlshort

# --------------------------------------------------------------- redis ------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
# Aggressive on purpose: Redis is on the hot path, so a slow Redis must be
# treated as a down Redis rather than blocking every request on one socket.
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_CONNECT_TIMEOUT_SECONDS=0.25

# --------------------------------------------------------------- cache ------
# Set to false to reproduce the BASELINE benchmark (every redirect goes to
# PostgreSQL). See docs/PERFORMANCE.md.
CACHE_ENABLED=true
CACHE_KEY_PREFIX=url
CACHE_SCHEMA_VERSION=1
CACHE_TTL_SECONDS=300
# Random 0..N seconds added per key so a burst of links created together does
# not all expire in the same second (cache stampede mitigation).
CACHE_TTL_JITTER_SECONDS=60
# Negative cache for unknown codes -- stops a bot walking random codes from
# turning into one PostgreSQL query per request.
CACHE_NEGATIVE_TTL_SECONDS=30

# ---------------------------------------------------------- rate limit ------
RATE_LIMIT_ENABLED=true
# General API reads.
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Writes (POST/DELETE): each one is a DB write and permanently consumes a code.
RATE_LIMIT_WRITE_REQUESTS=20
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# Redirects: cache-served and cheap, and one office NAT address legitimately
# generates a lot of clicks on a popular link.
RATE_LIMIT_REDIRECT_REQUESTS=1000
RATE_LIMIT_REDIRECT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=rl
# Redis-unavailable behaviour. Reads/redirects fail OPEN (a cache outage must
# not become a site outage); writes fail CLOSED (never expose an unmetered
# write path). Both are argued in docs/ENGINEERING_DECISIONS.md.
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_WRITE_FAIL_OPEN=false
# Number of trusted proxies in front of the app. The client IP is read this
# many entries from the RIGHT of X-Forwarded-For, so a client cannot spoof its
# identity by sending its own header. 1 = just our Nginx.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=X-Forwarded-For

# --------------------------------------------------------- short codes ------
# 7 chars of base62 = 3.5e12 codes. See app/services/short_code.py for the
# collision math.
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_ATTEMPTS=5
SHORT_CODE_MAX_LENGTH=16
ALLOW_CUSTOM_ALIAS=true

# ------------------------------------------------- url validation / ssrf ----
URL_MAX_LENGTH=2048
ALLOWED_URL_SCHEMES=http,https
# false = refuse to mint links pointing at loopback / RFC1918 / link-local
# addresses. Set true ONLY for an internal deployment where that is intended.
ALLOW_PRIVATE_URL_TARGETS=false
MAX_REQUEST_BODY_BYTES=16384

# -------------------------------------------------------- click counting ----
# Buffer click increments in Redis and write them back in batches instead of
# doing one UPDATE per redirect. Set false to benchmark the naive path.
CLICK_FLUSH_ENABLED=true
CLICK_FLUSH_INTERVAL_SECONDS=5.0
CLICK_FLUSH_BATCH_SIZE=500

# ---------------------------------------------------------------- http ------
# Origins allowed to call the API from a browser. The Vite dev server (5173)
# and the Nginx-served production frontend (8080).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
GRACEFUL_SHUTDOWN_SECONDS=10

# ------------------------------------------------------------- grafana ------
# Local-only default. Change before exposing Grafana anywhere.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
